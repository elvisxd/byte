# API de Byte. Imagen chica y proceso sin root.
# La versión de Python debe estar dentro del rango de `requires-python` del
# pyproject: con 3.14, pydantic no puede ni importarse (usa una API de `typing`
# que 3.14 cambió). El job `imagen` del CI construye esta imagen y verifica que
# la app arranque, justamente para que eso no se descubra al desplegar.
FROM python:3.13-slim

# uv instala las dependencias desde el lock, sin resolver de nuevo.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Capa de dependencias aparte: no se reinstala con cada cambio de código.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY api/ api/
COPY agent/ agent/
COPY tools/ tools/
COPY models/ models/
COPY db/ db/
COPY rag/ rag/
COPY web/ web/
# `api/routes/ofertas.py` importa `empleo` al cargar el módulo, así que sin esto
# la imagen se construye y `import api.main` revienta adentro. Lo encontró el
# job `imagen` del CI, que existe justamente para eso.
COPY empleo/ empleo/
# Sólo el criterio, NO `perfil/` entero: ahí viven `privado.md` y `privado.toml`
# —dónde vas a estar viviendo, el vencimiento del permiso— y una imagen se
# publica. El `.dockerignore` los excluye también, pero copiar un archivo
# nombrado no depende de que nadie se olvide de mantener esa lista.
COPY perfil/busqueda.toml perfil/busqueda.toml

RUN useradd --create-home --uid 10001 byte && chown -R byte:byte /app
USER byte

EXPOSE 8000

# Un solo worker: el agente guarda estado de los runs en memoria del proceso.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
