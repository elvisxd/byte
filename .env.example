# Copiar a .env y completar. NUNCA commitear .env

# --- Credenciales ---
# Clave para el CLI y la web. Generar una: openssl rand -hex 32
BYTE_API_KEY=cambiame
# Firma la cookie de sesión y los events_token. Obligatoria con BYTE_ENV=prod.
BYTE_SECRET_KEY=cambiame
BYTE_ENV=dev

# --- Modelo (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Ollama arranca en 4096 aunque el modelo soporte más: se setea explícito.
OLLAMA_NUM_CTX=16384
# Tope de tokens por respuesta.
OLLAMA_NUM_PREDICT=1024

# --- Persistencia ---
# Sin DATABASE_URL, Byte arranca en memoria (se pierde todo al reiniciar).
DATABASE_URL=postgresql://byte:byte@localhost:5432/byte
# auto (según DATABASE_URL) | memory | postgres
BYTE_STORAGE=auto

# --- Herramientas ---
# Sin esta clave el agente arranca, pero sin búsqueda web.
TAVILY_API_KEY=
# Sandbox de ejecución de código. Sin URL o sin token, el agente arranca sin
# la herramienta de ejecutar código.
SANDBOX_URL=http://localhost:3000
# El mismo valor va en el servicio sandbox. Generar: openssl rand -hex 32
SANDBOX_TOKEN=

# --- Límites (costos y seguridad) ---
BYTE_MAX_ITERATIONS=6
# 10 minutos: un run son varias llamadas al modelo y en CPU un 7B hace ~5-15
# tokens por segundo. Con 3 minutos se cortan runs legítimos en la primera
# prueba local.
BYTE_RUN_TIMEOUT_S=600
BYTE_MAX_MESSAGE_CHARS=8000
BYTE_MAX_CONCURRENT_RUNS=2
BYTE_MAX_TOOL_RESULT_CHARS=4000
BYTE_MAX_SEARCH_QUERY_CHARS=200
BYTE_RATE_LIMIT_GENERAL=60/minute
BYTE_RATE_LIMIT_RUNS=10/minute

# --- Web ---
# Orígenes permitidos para CORS, separados por coma. Vacío = sin CORS.
BYTE_CORS_ORIGINS=
# Cuánto vale el token para aprobar una ejecución (modo seguro). Mientras tanto,
# el run pausado no se descarta.
BYTE_RESUME_TOKEN_TTL_S=3600

# --- Observabilidad (Fase 4) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
BUGSINK_DSN=
